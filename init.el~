(defun my-eshell-directory-at-point ()
  "Devuelve el directorio bajo el cursor, o nil."
  (let* ((name (thing-at-point 'filename t)))
    (when name
      (let ((path (expand-file-name name default-directory)))
        (when (file-directory-p path)
          path)))))

(defun my-eshell-smart-return ()
  "En eshell:
- sobre un directorio -> cd
- en el prompt -> enviar comando
- en cualquier otro lugar -> comportamiento normal."
  (interactive)
  (if-let ((dir (my-eshell-directory-at-point)))
      (progn
        (goto-char (point-max))
        (insert (concat "cd " (shell-quote-argument dir) " && ls -d */"))
        (eshell-send-input)
        ;; mejorar esto (en vez de 4 lineas buscar el comienzo de ls)
        (forward-line -3)
      )
    (if (>= (point) (marker-position eshell-last-output-end))
        (eshell-send-input)
      (goto-char (point-max)))))

(with-eval-after-load 'evil
  (add-hook 'eshell-mode-hook
            (lambda ()
              (evil-define-key 'normal eshell-mode-map (kbd "RET") #'my-eshell-smart-return)
              (evil-define-key 'normal eshell-mode-map (kbd "-")
                (lambda ()
                  (interactive)
                  (goto-char (point-max))
                  (insert ".. && ls -d */")
                  (eshell-send-input)
                  ;; mejorar esto (en vez de 4 lineas buscar el comienzo de ls)
                  (forward-line -3)
                  ))
            )
  )
)

